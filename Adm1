-- Visualizer Ring Container
local activeLockRings = {}

local function createLockRing(color)
    local ring = Instance.new("Part")
    ring.Name = "BeatIt_LockRing"
    ring.Shape = Enum.PartType.Ball
    ring.Size = Vector3.new(lockRange * 2, lockRange * 2, lockRange * 2)
    ring.Color = color or Color3.fromRGB(220, 20, 45)
    ring.Material = Enum.Material.Neon
    ring.Transparency = 1
    ring.CanCollide = false
    ring.CanTouch = false
    ring.CanQuery = false
    ring.Anchored = true
    ring.Parent = Workspace
    return ring
end

-- Allowed Players Manager
local allowedPlayers = {}
local playerStates = {}
local selectedAllowPlayer = nil

local function getPlayerState(plr)
    if not playerStates[plr.UserId] then
        playerStates[plr.UserId] = {
            bodyLockOn = false,
            toolLockOn = false,
            tripleAbyssActive = false,
            tripleAbyssTarget = nil
        }
    end
    return playerStates[plr.UserId]
end

local function isPlayerAllowed(plr)
    if not plr then return false end
    return allowedPlayers[plr.UserId] == true
end

local function isPlayerAllowedOrSelf(plr)
    if not plr then return false end
    if plr == LocalPlayer then return true end
    return allowedPlayers[plr.UserId] == true
end

