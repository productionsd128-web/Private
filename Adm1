        end
    else
        selectedAllowPlayer = nil
        AllowPFP.Image = "rbxassetid://0"
        ToggleAllowBtn.Text = "Allow"
        ToggleAllowBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
    end
end

