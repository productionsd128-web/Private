    LeftRedAccent.BackgroundColor3 = Color3.fromRGB(220, 20, 45)
    LeftRedAccent.BorderSizePixel = 0
    LeftRedAccent.Parent = NotifFrame

    local AccentCorner = Instance.new("UICorner")
    AccentCorner.CornerRadius = UDim.new(1, 0)
    AccentCorner.Parent = LeftRedAccent

    local NotifTitle = Instance.new("TextLabel")
    NotifTitle.Size = UDim2.new(1, -16, 0, 14)
    NotifTitle.Position = UDim2.new(0, 12, 0, 3)
    NotifTitle.BackgroundTransparency = 1
    NotifTitle.Text = titleText
    NotifTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    NotifTitle.TextSize = 9
    NotifTitle.TextScaled = true
    NotifTitle.Font = Enum.Font.GothamBold
    NotifTitle.TextXAlignment = Enum.TextXAlignment.Left
    NotifTitle.Parent = NotifFrame

    local NotifBody = Instance.new("TextLabel")
    NotifBody.Size = UDim2.new(1, -16, 0, 14)
    NotifBody.Position = UDim2.new(0, 12, 0, 18)
    NotifBody.BackgroundTransparency = 1
    NotifBody.Text = bodyText
    NotifBody.TextColor3 = Color3.fromRGB(180, 180, 195)
    NotifBody.TextSize = 8
    NotifBody.TextScaled = true
    NotifBody.Font = Enum.Font.GothamMedium
    NotifBody.TextXAlignment = Enum.TextXAlignment.Left
    NotifBody.Parent = NotifFrame

    local NotifScale = Instance.new("UIScale")
    NotifScale.Scale = 0
    NotifScale.Parent = NotifFrame

    TweenService:Create(NotifScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()

    task.delay(2.5, function()
        local exitTween = TweenService:Create(NotifScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0})
        exitTween:Play()
        exitTween.Completed:Connect(function()
            NotifFrame:Destroy()
        end)
    end)
end

local function updateTargetVisuals(plr)
    if plr then
        selectedTargetPlayer = plr
        dTgtPlayer = plr
        UserTextBox.Text = plr.DisplayName
        TargetPFP.Image = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=150&h=150"
    else
        selectedTargetPlayer = nil
        dTgtPlayer = nil
        TargetPFP.Image = "rbxassetid://0"
    end
end

local function getTargetPlayer(str, speaker)
    if not str or str == "" then return nil end
    str = string.lower(str)
    if str == "me" then return speaker or LocalPlayer end
    if str == "random" then
        local otherPlayers = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if not isPlayerAllowedOrSelf(plr) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(otherPlayers, plr)
            end
        end
        if #otherPlayers > 0 then return otherPlayers[math.random(1, #otherPlayers)] end
        return nil
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if string.sub(string.lower(plr.Name), 1, #str) == str or string.sub(string.lower(plr.DisplayName), 1, #str) == str then
            return plr
        end
    end
    return nil
end

