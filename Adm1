ToggleAllowBtn.MouseButton1Click:Connect(function()
    local targetPlr = selectedAllowPlayer or currentSuggestedPlayer or getTargetPlayer(AllowTextBox.Text, LocalPlayer)
    if targetPlr then
        if allowedPlayers[targetPlr.UserId] then
            allowedPlayers[targetPlr.UserId] = nil
            playerStates[targetPlr.UserId] = nil
            sendNotification("ALLOW", "Unallowed " .. targetPlr.DisplayName)
        else
            allowedPlayers[targetPlr.UserId] = true
            sendNotification("ALLOW", "Allowed " .. targetPlr.DisplayName)
        end
        updateAllowPFPVisuals(targetPlr)
    else
        sendNotification("ALLOW", "No valid player specified!")
    end
end)

HitboxSizeTextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed or HitboxSizeTextBox.Text ~= "" then
        local num = tonumber(HitboxSizeTextBox.Text)
        if num and num > 0 then
            lockRange = num
            for _, ring in ipairs(activeLockRings) do
                if ring and ring.Part then
                    ring.Part.Size = Vector3.new(lockRange * 2, lockRange * 2, lockRange * 2)
                end
            end
            sendNotification("HITBOX", "Hitbox size set to: " .. tostring(lockRange))
            HitboxSizeTextBox.PlaceholderText = "Hitbox Size (Current: " .. tostring(lockRange) .. ")"
            HitboxSizeTextBox.Text = ""
        else
            sendNotification("HITBOX", "Invalid size number!")
        end
    end
end)

