local cachedPlate = nil
local function getMyPlate()
    if cachedPlate and cachedPlate.Parent then return cachedPlate end
    local platesFolder = Workspace:FindFirstChild("Plates")
    if not platesFolder then return nil end
    local myName = string.lower(LocalPlayer.Name)
    local myUserId = tostring(LocalPlayer.UserId)
    
    for _, model in ipairs(platesFolder:GetChildren()) do
        local ownerVal = model:FindFirstChild("Owner")
        if ownerVal then
            local strVal = string.lower(tostring(ownerVal.Value))
            if string.find(strVal, myName, 1, true) or string.find(strVal, myUserId, 1, true) then
                cachedPlate = model:FindFirstChild("Plate") or model
                return cachedPlate
            end
        end
    end
    return nil
end

-- HIGH-FREQUENCY DELETE REMOVAL ENGINE
local function clearActiveParts()
    local myPlate = getMyPlate()
    if not myPlate then return end
    local plotFolder = myPlate.Parent
    if not plotFolder then return end
    
    local activeParts = plotFolder:FindFirstChild("ActiveParts")
    if deleteRemote then
        if activeParts then
            for _, asset in ipairs(activeParts:GetChildren()) do
                task.spawn(function()
                    pcall(function() deleteRemote:InvokeServer(asset) end)
                    pcall(function() deleteRemote:InvokeServer(asset) end)
                end)
            end
        end
        task.spawn(function()
            pcall(function() deleteRemote:InvokeServer(Instance.new("Model", nil)) end)
            pcall(function() deleteRemote:InvokeServer(Instance.new("Model", nil)) end)
            pcall(function() deleteRemote:InvokeServer(Instance.new("Folder", nil)) end)
        end)
    end
end

local function triggerTripleAbyss(tgt)
    if isPlayerAllowed(tgt) then return end
    local pl = getMyPlate()
    if not pl or not tgt or not tgt.Character then return end
    local hrp = tgt.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local cf = pl.CFrame * CFrame.new(0, -1000, 0)
    if stampRemote and deleteRemote then
        task.spawn(clearActiveParts)

        pcall(function() stampRemote:InvokeServer(56449778, cf, "{" .. HttpService:GenerateGUID(false) .. "}", {hrp}, 1) end)
        task.spawn(function() pcall(function() deleteRemote:InvokeServer(Instance.new("Model", nil)) end) end)
        
        task.wait(deleteSpeed)
        pcall(function() stampRemote:InvokeServer(56449778, cf, "{" .. HttpService:GenerateGUID(false) .. "}", {hrp}, 1) end)
        task.spawn(function() pcall(function() deleteRemote:InvokeServer(Instance.new("Model", nil)) end) end)

        task.wait(deleteSpeed)
        pcall(function() stampRemote:InvokeServer(56449778, cf, "{" .. HttpService:GenerateGUID(false) .. "}", {hrp}, 1) end)

        for i = 1, 4 do
            task.spawn(function()
                pcall(function() deleteRemote:InvokeServer(Instance.new("Model", nil)) end)
            end)
        end
    end
end

local function iLock(tgt, f, part, pos)
    if isPlayerAllowed(tgt) then return end
    local ap = f:FindFirstChild("ActiveParts")
    local tp = tgt.Character and tgt.Character:FindFirstChild(part)
    if not tp then return end

    if not ap then
        ap = Instance.new("Folder")
        ap.Name = "ActiveParts"
        ap.Parent = f
    end

    local c
    c = ap.DescendantAdded:Connect(function(d)
        if d.Name == "Spikes" and d:IsA("BasePart") and not d:FindFirstChild("_u") then
            Instance.new("BoolValue", d).Name = "_u"
            c:Disconnect()
            task.wait(deleteSpeed)
            pcall(function()
                if stampRemote then
                    stampRemote:InvokeServer(56451715, pos, "{" .. HttpService:GenerateGUID(false) .. "}", {tp, d}, 0)
                end
            end)
            if deleteRemote then
                task.spawn(function()
                    pcall(function() deleteRemote:InvokeServer(d) end)
                    pcall(function() deleteRemote:InvokeServer(Instance.new("Model", nil)) end)
                end)
            end
        end
    end)

    local pp = f:FindFirstChild("Plate")
    if pp then
        pcall(function()
            if stampRemote then
                stampRemote:InvokeServer(41324904, pp.CFrame, "{" .. HttpService:GenerateGUID(false) .. "}", {pp}, 0)
            end
        end)
    end

    task.delay(0.6, function()
        if c then c:Disconnect() end
    end)
end

local function disform(tgt, overrideMode)
    if isPlayerAllowed(tgt) or disForming then return end
    disForming = true

    local myPlate = getMyPlate()
    local f = myPlate and myPlate.Parent
    if not f or not tgt or not tgt.Character or not tgt.Character:FindFirstChild("HumanoidRootPart") then
        disForming = false
        return
    end

    local pp = f:FindFirstChild("Plate") or f
    if not pp then
        disForming = false
        return
    end

    local vCF = CFrame.new(pp.Position.X, -1000, pp.Position.Z)
    local m = overrideMode or dModes[dIdx]

    if m == "all parts" then
        for _, limb in ipairs({"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}) do
            task.spawn(iLock, tgt, f, limb, vCF)
            task.wait(stampSpeed)
        end
    else
        iLock(tgt, f, m, vCF)
    end

    task.spawn(clearActiveParts)
    task.wait(dCool)
    disForming = false
end

local function vStamp(tgt)
    if lockingState or not tgt then return end
    lockingState = true
    local pl = getMyPlate()
    if pl and stampRemote and deleteRemote then
        local cf = pl.CFrame * CFrame.new(0, -100, 0)
        for _, id in ipairs(stampVA) do
            pcall(function()
                stampRemote:InvokeServer(id, cf, "{" .. HttpService:GenerateGUID(false) .. "}", {tgt}, 1)
            end)
            task.spawn(function()
                pcall(function() deleteRemote:InvokeServer(Instance.new("Model", nil)) end)
                pcall(function() deleteRemote:InvokeServer(Instance.new("Folder", nil)) end)
            end)
            task.wait(stampSpeed)
        end
    end
    task.spawn(clearActiveParts)
    task.wait(0.95)
    lockingState = false
end

local function getActiveLockSources()
    local sources = {}
    if toolLockOn or bodyLockOn or tripleAbyssActive then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(sources, {
                Player = LocalPlayer, 
                Root = LocalPlayer.Character.HumanoidRootPart, 
                Color = Color3.fromRGB(220, 20, 45),
                State = {bodyLockOn = bodyLockOn, toolLockOn = toolLockOn, tripleAbyssActive = tripleAbyssActive, tripleAbyssTarget = tripleAbyssTarget}
            })
        end
    end

    for userId, isAllowed in pairs(allowedPlayers) do
        if isAllowed then
            local plr = Players:GetPlayerByUserId(userId)
            if plr and plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(sources, {
                    Player = plr, 
                    Root = plr.Character.HumanoidRootPart, 
                    Color = Color3.fromRGB(45, 220, 80),
                    State = {bodyLockOn = bodyLockOn, toolLockOn = toolLockOn, tripleAbyssActive = tripleAbyssActive, tripleAbyssTarget = tripleAbyssTarget}
                })
            end
        end
    end
    return sources
end

-- FIXED HITBOX & LOCK HEARTBEAT LOOP
RunService.Heartbeat:Connect(function()
    local now = tick()
    local lockSources = getActiveLockSources()

    for i, source in ipairs(lockSources) do
        local ringData = activeLockRings[i]
        if not ringData then
            local p = createLockRing(source.Color)
            ringData = {Part = p, Color = source.Color}
            activeLockRings[i] = ringData
        end
        if ringData.Color ~= source.Color then
            ringData.Part.Color = source.Color
            ringData.Color = source.Color
        end
        ringData.Part.CFrame = source.Root.CFrame
        ringData.Part.Transparency = 0.88
    end

    for i = #lockSources + 1, #activeLockRings do
        if activeLockRings[i] and activeLockRings[i].Part then
            activeLockRings[i].Part.Transparency = 1
        end
    end

    local function runTargetsForPlayer(targetPlr)
        if not targetPlr or (targetPlr ~= LocalPlayer and isPlayerAllowed(targetPlr)) or not targetPlr.Character then return end
        local targetRoot = targetPlr.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end

        for _, source in ipairs(lockSources) do
            local sourceRoot = source.Root
            local st = source.State
            local inRange = (sourceRoot.Position - targetRoot.Position).Magnitude <= lockRange

            if inRange then
                if st.toolLockOn then
                    local t = targetPlr.Character:FindFirstChildWhichIsA("Tool")
                    if t and toolSpy[t.Name] then
                        vStamp(t:FindFirstChild("Handle") or t:FindFirstChildWhichIsA("BasePart"))
                    end
                end

                if st.bodyLockOn then
                    local targetPart = targetPlr.Character:FindFirstChild(currentBodyPart)
                    if targetPart then
                        vStamp(targetPart)
                    end
                end

                if st.tripleAbyssActive then
                    if now - lastAbyssTime >= ABYSS_COOLDOWN then
                        lastAbyssTime = now
                        task.spawn(triggerTripleAbyss, targetPlr)
                    end
                end
            end
        end
    end

    if disOn and now - dLast >= dCool then
        if effectAllPlayers then
            for _, plr in ipairs(Players:GetPlayers()) do
                if not isPlayerAllowed(plr) then
                    dLast = now
                    task.spawn(disform, plr, nil)
                end
            end
        elseif dTgtPlayer and (dTgtPlayer == LocalPlayer or not isPlayerAllowed(dTgtPlayer)) then
            dLast = now
            task.spawn(disform, dTgtPlayer, nil)
        end
    end

    if effectAllPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            runTargetsForPlayer(plr)
        end
    elseif selectedTargetPlayer then
        runTargetsForPlayer(selectedTargetPlayer)
    end
end)

