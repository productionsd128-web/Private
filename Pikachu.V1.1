        {id = IDs.Yellow, pos = Vector3.new(0, 0, 1)}, {id = IDs.Yellow, pos = Vector3.new(1, 0, 1)},
        {id = IDs.Yellow, pos = Vector3.new(0, 1, 1)}, {id = IDs.Yellow, pos = Vector3.new(1, 1, 1)}
    }
    local legRLayout = {
        {id = IDs.Yellow, pos = Vector3.new(0, 0, 0)}, {id = IDs.Yellow, pos = Vector3.new(-1, 0, 0)},
        {id = IDs.Yellow, pos = Vector3.new(0, 1, 0)}, {id = IDs.Yellow, pos = Vector3.new(-1, 1, 0)},
        {id = IDs.Yellow, pos = Vector3.new(0, 0, 1)}, {id = IDs.Yellow, pos = Vector3.new(-1, 0, 1)},
