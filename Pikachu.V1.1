local function getMyFolder()
    for _, f in pairs(workspace.Plates:GetChildren()) do
        local owner = f:FindFirstChild("Owner")
        if owner and (tostring(owner.Value) == lp.Name or tostring(owner.Value) == tostring(lp.UserId)) then
            return f
        end
    end
    return nil
end

local function getNearestPlayer()
    local nearest, dist = nil, GRAB_HITBOX_RADIUS
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and spawnPivot then
            local d = (p.Character.HumanoidRootPart.Position - spawnPivot.Position).Magnitude
            if d < dist then
                dist = d
                nearest = p.Character.HumanoidRootPart
            end
        end
    end
    return nearest
end

local function getLockedTarget(dt)
    lockedTargetTimer = lockedTargetTimer + dt
    if lockedTarget and lockedTarget.Parent and lockedTargetTimer < LOCK_DURATION then
        return lockedTarget
    end
    local nearest = getNearestPlayer()
    if nearest ~= lockedTarget then
        lockedTarget = nearest
        lockedTargetTimer = 0
    end
    return lockedTarget
end

