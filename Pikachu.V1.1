    }

    local earLLayout = {
        {id = IDs.Yellow, pos = Vector3.new(0, 0, 0)},
        {id = IDs.Yellow, pos = Vector3.new(-0.5, 1, 0)},
        {id = IDs.Black, pos = Vector3.new(-1, 2, 0)}
    }
    local earRLayout = {
        {id = IDs.Yellow, pos = Vector3.new(0, 0, 0)},
