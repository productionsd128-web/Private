local function build3D()
    clearDummy()
    local folder = getMyFolder()
    if not (folder and folder:FindFirstChild("Plate")) then return end
    spawnPivot = folder.Plate.CFrame * CFrame.new(0, 4, 0) * CFrame.Angles(0, math.pi, 0)

    local function spawnCustomStructure(layoutMap, targetTable)
        for _, item in ipairs(layoutMap) do
            local part = nil
            local conn = folder.DescendantAdded:Connect(function(p)
                if p:IsA("BasePart") and p.Name ~= "Plate" then part = p end
            end)
            stampRemote:InvokeServer(item.id, spawnPivot * CFrame.new(0, 60, 0), "{36e9d98d-9757-4da1-ba5d-b9bbeb0097ba}", {}, 0)
            local start = tick()
            repeat task.wait() until part or (tick() - start > 1)
            conn:Disconnect()
            if part then
                part:SetAttribute("GridPos", item.pos)
                if item.isEye then part:SetAttribute("IsEye", item.isEye) end
                table.insert(targetTable, part)
            end
            task.wait(0.12)
        end
    end

    local headLayout = {}
    for z = 0, 2 do
        for y = 0, 2 do
            for x = 0, 3 do
                table.insert(headLayout, {id = IDs.Yellow, pos = Vector3.new(x - 0.5, y, z)})
            end
        end
    end
    table.insert(headLayout, {id = IDs.Black, pos = Vector3.new(0, 1, 3), isEye = "Left"})
    table.insert(headLayout, {id = IDs.Black, pos = Vector3.new(2.5, 1, 3), isEye = "Right"})

    local torsoLayout = {}
    for z = 0, 2 do
        for y = 0, 2 do
            for x = 0, 3 do
                table.insert(torsoLayout, {id = IDs.Yellow, pos = Vector3.new(x - 0.5, y, z)})
            end
        end
    end
    table.insert(torsoLayout, {id = IDs.Black, pos = Vector3.new(0.5, 2, -1)})
    table.insert(torsoLayout, {id = IDs.Black, pos = Vector3.new(1.5, 2, -1)})

    local armLLayout = {
        {id = IDs.Yellow, pos = Vector3.new(0, 0, 0)}, {id = IDs.Yellow, pos = Vector3.new(0, 1, 0)},
        {id = IDs.Yellow, pos = Vector3.new(0, 0, 1)}, {id = IDs.Yellow, pos = Vector3.new(0, 1, 1)}
    }
    local armRLayout = {
        {id = IDs.Yellow, pos = Vector3.new(0, 0, 0)}, {id = IDs.Yellow, pos = Vector3.new(0, 1, 0)},
        {id = IDs.Yellow, pos = Vector3.new(0, 0, 1)}, {id = IDs.Yellow, pos = Vector3.new(0, 1, 1)}
    }

    local legLLayout = {
