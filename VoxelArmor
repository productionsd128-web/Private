local function getPlatePart()
    local pl = workspace:FindFirstChild("Plates")
    if not pl then return nil, nil end
    for _, f in ipairs(pl:GetChildren()) do
        local o = f:FindFirstChild("Owner")
        if o and (tostring(o.Value)==lp.Name or tostring(o.Value)==tostring(lp.UserId)) then
            return f:FindFirstChild("Plate"), f
        end
    end
    return nil, nil
end

local function getPoolParts(folder)
    if not folder then return {} end
    local ap = folder:FindFirstChild("ActiveParts")
    if not ap then return {} end
    local parts = {}
    for _, v in ipairs(ap:GetDescendants()) do
        if v:IsA("BasePart") and v.Name ~= "Plate" then
            table.insert(parts, v)
        end
    end
    return parts
end

local function findTarget()
    local t = STATE.targetName:gsub("%s+","")
    if t == "" then return lp end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1,#t)==t:lower() or p.DisplayName:lower():sub(1,#t)==t:lower() then
            return p
        end
    end
    return nil
end

