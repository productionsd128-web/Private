local function getSkinID(skin, limb)
    local isArm  = limb:find("Arm")
    local isLeg  = limb:find("Leg")
    local isHead = limb == "Head"
    local isTors = limb == "Torso"

    if skin == "blocky :3" then
        return isTors and ID.Gray or ID.Slate
    elseif skin == "Noobish" then
        if isTors then return ID.Blue
        elseif isLeg then return ID.Green
        else return ID.Yellow end
    elseif skin == "Slasher" then
        return isTors and ID.Slate or ID.Red
    elseif skin == "tuff" then
        return isTors and ID.Yellow or ID.Black
    elseif skin == "bighead" then
        if isHead then return ID.Black
        elseif isTors then return ID.Gray
        else return ID.Slate end
    elseif skin == "Female" then
        return isTors and ID.White or ID.Gray
    elseif skin == "Female 2" then
        return isTors and ID.Magenta or ID.Pink
    elseif skin == "Cyber" then
        if isTors then return ID.Black
        elseif isArm then return ID.Cyan
        elseif isLeg then return ID.Purple
        else return ID.Black end
    elseif skin == "Ghost" then
        return isTors and ID.Black or ID.Ice
    elseif skin == "Gold" then
        return isLeg and ID.Orange or ID.Yellow
    elseif skin == "Void" then
        return isHead and ID.Purple or ID.Black
    end
    return ID.Slate
end

-- ============================================================================
-- ARMOR OFFSETS BUILDER
-- ============================================================================

local function buildOffsets()
    local offsets = {}
    
    local isFemale = STATE.skin == "Female" or STATE.skin == "Female 2"
    local isBig    = STATE.skin == "bighead"

    local function addMain(limb, x, y, z)
        table.insert(offsets, {limb = limb, offset = CFrame.new(x, y, z), type = "main", skinName = STATE.skin, cloneSide = 0})
    end

    -- HEAD (Main)
    if isBig then
        for _, p in ipairs({
            {0,0,1.2},{-0.8,0,1.2},{0.8,0,1.2},
            {0,0.8,1.2},{-0.8,0.8,1.2},{0.8,0.8,1.2},
            {0,-0.8,1.2},{-0.8,-0.8,1.2},{0.8,-0.8,1.2},
            {0,1.4,0},{-0.8,1.0,0},{0.8,1.0,0},
            {0,0,-1.2},{0,-1.0,0},
        }) do addMain("Head",p[1],p[2],p[3]) end
    else
        addMain("Head", 0, isFemale and 0.55 or 1.0, 0)
        addMain("Head", 0, 0.2, isFemale and 0.5 or 0.9)
        addMain("Head", 0, 0.4, isFemale and -0.5 or -0.9)
        addMain("Head", isFemale and -0.5 or -0.9, 0.3, 0)
        addMain("Head", isFemale and 0.5 or 0.9, 0.3, 0)
        addMain("Head", 0, -0.4, isFemale and 0.55 or 1.0)
    end

    -- TORSO (Main - 16)
    local fw = isFemale and 1.2 or 1.4
    addMain("Torso", 0,    0.6,  isFemale and 0.95 or 0.8)
    addMain("Torso", 0,   -0.6,  isFemale and 0.65 or 0.8)
    addMain("Torso",-0.8,  0,    0.8)
    addMain("Torso", 0.8,  0,    0.8)
    addMain("Torso", 0,    0.6, -0.8)
    addMain("Torso", 0,   -0.6, -0.8)
    addMain("Torso",-0.8,  0,   -0.8)
    addMain("Torso", 0.8,  0,   -0.8)
    addMain("Torso",-fw,   0.8,  0)
    addMain("Torso",-fw,   0,    0)
    addMain("Torso",-fw,  -0.8,  0)
    addMain("Torso", fw,   0.8,  0)
    addMain("Torso", fw,   0,    0)
    addMain("Torso", fw,  -0.8,  0)
    addMain("Torso",-0.5,  1.2,  0)
    addMain("Torso", 0.5,  1.2,  0)

    -- ARMS (Main - 16)
    for _, arm in ipairs({"Left Arm","Right Arm"}) do
        local s  = arm=="Left Arm" and -1 or 1
        local aw = isFemale and 0.35 or 0.6
        addMain(arm, s*aw,                         0.8,  0)
        addMain(arm, s*(isFemale and 0.4 or 0.8),  0.4,  0)
        addMain(arm, 0,  0,  isFemale and  0.4 or  0.7)
        addMain(arm, 0,  0,  isFemale and -0.4 or -0.7)
        addMain(arm, s*(isFemale and 0.4 or 0.7), -0.4,  0)
        addMain(arm, 0, -0.8, isFemale and  0.4 or  0.7)
        addMain(arm, 0, -0.8, isFemale and -0.4 or -0.7)
        addMain(arm, s*(isFemale and 0.4 or 0.7), -1.2,  0)
    end

    -- LEGS (Main - 16)
    for _, leg in ipairs({"Left Leg","Right Leg"}) do
        local s  = leg=="Left Leg" and -1 or 1
        local tw = isFemale and 0.85 or 0.7
        addMain(leg, 0,     0.8,   0.7)
        addMain(leg, 0,     0.8,  -0.7)
        addMain(leg, s*tw,  0.4,   0)
        addMain(leg, 0,     0,     0.7)
        addMain(leg, 0,    -0.6,   0.7)
        addMain(leg, 0,    -0.6,  -0.7)
        addMain(leg, s*0.7,-1.0,   0)
        addMain(leg, 0,    -1.2,   0.9)
    end

    -- 2. Clone Armor Arrays (24 blocks per small variant)
    if STATE.cloneStandOn then
        local function buildSmallLayout(offsetsArray, skinName, sideSign)
            local function addSmall(limb, x, y, z)
                table.insert(offsetsArray, {
                    limb = limb, 
                    offset = CFrame.new(x, y, z), 
                    type = "clone", 
                    skinName = skinName,
                    cloneSide = sideSign
                })
            end
            -- Head (2)
            addSmall("Head", 0, 1.0, 0)
            addSmall("Head", 0, 0.2, 0.8)
            -- Torso (6)
            addSmall("Torso", 0, 0.5, 0.7)
            addSmall("Torso", 0, -0.5, 0.7)
            addSmall("Torso", 0, 0.5, -0.7)
            addSmall("Torso", -1.1, 0, 0)
            addSmall("Torso", 1.1, 0, 0)
            addSmall("Torso", 0, 1.1, 0)
            -- Arms (4 each / 8 total)
            for _, arm in ipairs({"Left Arm", "Right Arm"}) do
                local s = arm == "Left Arm" and -1 or 1
                addSmall(arm, s*0.6, 0.4, 0)
                addSmall(arm, 0, 0, 0.6)
                addSmall(arm, 0, -0.6, 0.6)
                addSmall(arm, s*0.6, -1.0, 0)
            end
            -- Legs (4 each / 8 total)
            for _, leg in ipairs({"Left Leg", "Right Leg"}) do
                local s = leg == "Left Leg" and -1 or 1
                addSmall(leg, 0, 0.6, 0.6)
                addSmall(leg, s*0.6, 0, 0)
                addSmall(leg, 0, -0.6, 0.6)
                addSmall(leg, 0, -1.1, 0.7)
            end
        end

        buildSmallLayout(offsets, STATE.smallSkin1, -1)
        buildSmallLayout(offsets, STATE.smallSkin2, 1)
    end

    return offsets
end

