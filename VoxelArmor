end

local function togRow(label, ac, getter, setter)
    local c=inlineCard(28)
    local lbl=Instance.new("TextLabel",c)
    lbl.Size=UDim2.new(0.65,0,1,0) lbl.Position=UDim2.new(0,8,0,0)
    lbl.BackgroundTransparency=1 lbl.Text=label
    lbl.TextColor3=C.txt lbl.Font=Enum.Font.Gotham lbl.TextSize=9
    lbl.TextXAlignment=Enum.TextXAlignment.Left

    local p=Instance.new("TextButton",c)
    p.Size=UDim2.new(0,42,0,18) p.Position=UDim2.new(1,-48,0.5,-9)
    p.BackgroundColor3=C.panel p.BorderSizePixel=0
    p.Text="off" p.TextColor3=C.sub p.Font=Enum.Font.Gotham
    p.TextSize=9 p.AutoButtonColor=false
    Instance.new("UICorner",p).CornerRadius=UDim.new(0,4)
    Instance.new("UIStroke",p).Color=C.border

    local function ref()
        local on=getter()
        TS:Create(p,TweenInfo.new(0.15),{
            BackgroundColor3=on and ac or C.panel,
            TextColor3=on and C.bg or C.sub
        }):Play()
        p.Text=on and "on" or "off"
    end
    p.MouseButton1Click:Connect(function() setter(not getter()) ref() end)
    ref()
    return ref
end

local function cycleRow(label, list, stateKey, onChanged)
    local c=inlineCard(28)
    local lbl=Instance.new("TextLabel",c)
    lbl.Size=UDim2.new(0.5,0,1,0) lbl.Position=UDim2.new(0,8,0,0)
    lbl.BackgroundTransparency=1 lbl.Text=label
    lbl.TextColor3=C.txt lbl.Font=Enum.Font.Gotham lbl.TextSize=9
    lbl.TextXAlignment=Enum.TextXAlignment.Left

    local btn=Instance.new("TextButton",c)
    btn.Size=UDim2.new(0,80,0,18) btn.Position=UDim2.new(1,-86,0.5,-9)
    btn.BackgroundColor3=C.panel btn.BorderSizePixel=0
    btn.Text=tostring(STATE[stateKey]) btn.TextColor3=C.acc
    btn.Font=Enum.Font.GothamBold btn.TextSize=9 btn.AutoButtonColor=false
    Instance.new("UICorner",btn).CornerRadius=UDim.new(0,4)
    Instance.new("UIStroke",btn).Color=C.border

    btn.MouseButton1Click:Connect(function()
        local idx=1
        for i,v in ipairs(list) do
            if tostring(v)==tostring(STATE[stateKey]) then idx=i break end
        end
        STATE[stateKey]=list[(idx%#list)+1]
        btn.Text=tostring(STATE[stateKey])
        if onChanged then onChanged() end
    end)
    return btn
end

local function inpRow(ph, fn)
    local c=inlineCard(28)
    local b=Instance.new("TextBox",c)
    b.Size=UDim2.new(1,-12,0,20) b.Position=UDim2.new(0,8,0.5,-10)
    b.BackgroundTransparency=1 b.PlaceholderText=ph
    b.PlaceholderColor3=C.sub b.Text=""
    b.TextColor3=C.txt b.Font=Enum.Font.Gotham b.TextSize=9
    b.ClearTextOnFocus=false b.TextXAlignment=Enum.TextXAlignment.Left
    if fn then
        b:GetPropertyChangedSignal("Text"):Connect(function() fn(b.Text) end)
    end
    return b
end

local function actionBtn(text, color, fn)
    local b=Instance.new("TextButton",scroll)
    b.Size=UDim2.new(1,0,0,28) b.LayoutOrder=nxt()
    b.BackgroundColor3=color b.Text=text
    b.TextColor3=Color3.new(1,1,1) b.Font=Enum.Font.GothamBold
    b.TextSize=9 b.AutoButtonColor=false b.BorderSizePixel=0
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,6)
    b.MouseButton1Click:Connect(fn)
    return b
end

