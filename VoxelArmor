local function updatePoolSize()
    local baseArmorSize = 54
    if STATE.cloneStandOn then
        baseArmorSize = baseArmorSize + 24 + 24
    end
    STATE.armorMax  = baseArmorSize
    STATE.totalPool = STATE.armorMax + (STATE.auraOn and STATE.auraBlocks or 0)
end

local function stampPool(statusCb)
    if STATE.stamping then return end
    STATE.stamping  = true
    STATE.poolReady = false
    
    if STATE.cloneStandOn then
        local pool = {}
        for _, s in ipairs(SKINS) do if s ~= STATE.skin then table.insert(pool, s) end end
        if #pool > 0 then
            STATE.smallSkin1 = pool[math.random(1, #pool)]
            if #pool > 1 then
                for i, v in ipairs(pool) do if v == STATE.smallSkin1 then table.remove(pool, i) break end end
            end
            STATE.smallSkin2 = pool[math.random(1, #pool)]
        else
            STATE.smallSkin1 = STATE.skin
            STATE.smallSkin2 = STATE.skin
        end
    end
    
    updatePoolSize()

    local total    = STATE.totalPool
    local auraAmt  = STATE.auraOn and STATE.auraBlocks or 0

    if statusCb then statusCb(
        "forging "..total.."blk ("..STATE.armorMax.." armor + "..auraAmt.." aura)…",
        Color3.fromRGB(220,130,40)
    ) end

    task.spawn(function()
        local platePart, folder = getPlatePart()
        if not platePart then
            if statusCb then statusCb("error: stand on your plate", Color3.fromRGB(200,60,70)) end
            STATE.stamping = false
            return
        end

        STATE.offsets = buildOffsets()

        local cols = 10
        for i = 1, total do
            local row = math.floor((i-1)/cols)
            local col = (i-1) % cols
            local cf  = platePart.CFrame * CFrame.new((col*5)-22, 5, (row*5)-28)

            local blockID
            if i <= STATE.armorMax then
                local data = STATE.offsets[i]
                local limb = data and data.limb or "Torso"
                local activeSkin = data and data.skinName or STATE.skin
                blockID = getSkinID(activeSkin, limb)
            else
                blockID = (i%2==0) and ID.Black or ID.Gray
            end

            pcall(function()
                stamp:InvokeServer(blockID, cf, AUTH, {}, 0)
            end)
            task.wait(0.012)
        end

        STATE.stamping  = false
        STATE.poolReady = true
        if statusCb then statusCb(
            STATE.skin.." · "..total.."blk · aura:"..(STATE.auraOn and STATE.auraMode or "off"),
            Color3.fromRGB(60,200,100)
        ) end
    end)
end

-- ============================================================================
-- AURA POSITION
-- ============================================================================

local function getAuraPos(torsoPos, i, t)
    local anchorPos = torsoPos + Vector3.new(0, STATE.auraYOffset, 0)
    local total     = STATE.auraBlocks
    local radius    = STATE.auraRadius
    local speed     = STATE.auraSpeed
    local hAmp      = STATE.auraHeight
    local mode      = STATE.auraMode
    local ringDir   = (i%2==0) and 1 or -1
    local baseAngle = (i / total) * (math.pi * 2)

    if mode == "orbit" then
        local angle = baseAngle + t * speed * ringDir
        return anchorPos + Vector3.new(
            math.cos(angle) * radius,
            math.sin(t*2 + i*0.4) * hAmp * 0.15,
            math.sin(angle) * radius
        )
    elseif mode == "helix" then
        local angle  = baseAngle + t * speed
        local yPhase = math.sin(t*1.5 + i*0.3) * hAmp
        return anchorPos + Vector3.new(
            math.cos(angle) * radius,
            yPhase,
            math.sin(angle) * radius
        )
    elseif mode == "pulse" then
        local pulse = (math.sin(t*2.5) + 1) / 2
        local r     = radius * (0.4 + pulse * 1.2)
        local angle = baseAngle + t * speed * 0.8 * ringDir
        return anchorPos + Vector3.new(
            math.cos(angle) * r,
            math.sin(t*3 + i) * hAmp * 0.25,
            math.sin(angle) * r
        )
    elseif mode == "vortex" then
        local angle = baseAngle + t * speed * ringDir * 1.5
        local yOff  = -hAmp * 0.5 + (i/total) * hAmp
        local r     = radius * (0.3 + (i/total) * 1.4)
        return anchorPos + Vector3.new(
            math.cos(angle) * r,
            yOff,
            math.sin(angle) * r
        )
    elseif mode == "expand" then
        local beat  = (math.sin(t*3 + i*0.5) + 1) / 2
        local r     = radius * (0.2 + beat * 2.0)
        local angle = baseAngle + t * speed * 0.5 * ringDir
        return anchorPos + Vector3.new(
            math.cos(angle) * r,
            math.sin(t*2 + i) * hAmp * 0.2,
            math.sin(angle) * r
        )
    end
    return anchorPos
end

-- ============================================================================
-- HEARTBEAT
-- ============================================================================

Run.Heartbeat:Connect(function()
    if not STATE.equipped or not STATE.poolReady or STATE.stamping then return end

    local target = findTarget()
    local char   = target and target.Character
    if not char then return end

    local _, folder = getPlatePart()
    if not folder then return end

    local parts = getPoolParts(folder)
    if #parts == 0 then return end

    local offsets   = STATE.offsets
    local t         = tick()
    local platePart = folder:FindFirstChild("Plate")
    local torso     = char:FindFirstChild("Torso")
    local torsoPos  = torso and torso.Position or Vector3.zero

    for i = 1, STATE.totalPool do
        local part = parts[i]
        if not part then break end

        part.Anchored   = false
        part.CanCollide = false

        if i <= STATE.armorMax then
            local data = offsets[i]
            if data then
                if data.type == "clone" then
                    -- ── DANCE ENGINE LOGIC FOR CLONES ──
                    local speed = 5.5
                    local wave  = t * speed + (data.cloneSide * 1.2)
                    
                    -- Compute active procedural animation waves
                    local bounceY = math.abs(math.sin(wave)) * 0.9
                    local swayX   = math.cos(wave) * 0.4
                    local tiltZ   = math.sin(wave) * 0.15
                    
                    -- Calculate the clean ground position relative to Torso root matrix (independent of custom limbs)
                    local xShift = data.cloneSide * STATE.cloneSepX
                    local baseCenterOffset = Vector3.new(xShift + swayX, STATE.cloneSepY + bounceY, STATE.cloneSepZ)
                    local cloneCenterWorld = torso.CFrame * baseCenterOffset
                    
                    -- Individual limb rotation animations to mimic local dancing
                    local localLimbCF = data.offset
                    if data.limb == "Left Arm" or data.limb == "Right Arm" then
                        local multiplier = (data.limb == "Left Arm") and -1 or 1
                        localLimbCF = localLimbCF * CFrame.new(0, math.sin(wave * 1.5) * 0.2, 0) * CFrame.Angles(math.sin(wave) * 0.6 * multiplier, 0, 0)
                    elseif data.limb == "Left Leg" or data.limb == "Right Leg" then
                        local multiplier = (data.limb == "Left Leg") and -1 or 1
                        localLimbCF = localLimbCF * CFrame.new(0, 0, math.cos(wave * 1.5) * 0.15) * CFrame.Angles(math.cos(wave) * 0.4 * multiplier, 0, 0)
                    elseif data.limb == "Head" then
                        localLimbCF = localLimbCF * CFrame.Angles(0, math.sin(wave) * 0.25, math.cos(wave) * 0.1)
                    end
                    
                    -- Ground the position using a uniform base transformation matrix
                    part.CFrame = CFrame.new(cloneCenterWorld.Position) 
                                * CFrame.Angles(0, torso.CFrame.Rotation:ToEulerAnglesYXZ(), tiltZ) 
                                * localLimbCF
                                
                    part.AssemblyLinearVelocity  = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                else
                    -- Main armor maps tracking variables precisely to character limbs
                    local limb = char:FindFirstChild(data.limb)
                    if limb and limb:IsA("BasePart") then
                        part.CFrame = limb.CFrame * data.offset
                    end
                    part.AssemblyLinearVelocity  = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        else
            -- AURA
            if STATE.auraOn and torso then
                local auraIdx   = i - STATE.armorMax
                local targetPos = getAuraPos(torsoPos, auraIdx, t)
                local dir       = targetPos - part.Position
                local dist      = dir.Magnitude

                part.CFrame = CFrame.new(targetPos)

                local rd = (auraIdx%2==0) and 1 or -1
                part.AssemblyAngularVelocity = Vector3.new(0, rd*8, 0)

                if dist > 0.1 then
                    part.AssemblyLinearVelocity = dir.Unit * math.clamp(dist*40, 50, 220)
                else
                    part.AssemblyLinearVelocity = Vector3.zero
                end
            else
                if platePart then
                    part.CFrame = platePart.CFrame * CFrame.new(((i-STATE.armorMax)%10)*4-20, -200, 0)
                end
                part.AssemblyLinearVelocity  = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
end)

