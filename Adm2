                            local primaryBlock = activeBlocks[1]
                            if primaryBlock and primaryBlock.Parent then
                                if primaryBlock:IsA("BasePart") then
                                    primaryBlock.CFrame = plateStampCF
                                elseif primaryBlock:IsA("Model") then
                                    primaryBlock:PivotTo(plateStampCF)
                                end
                            end
                            handleExtraBlocks(activeBlocks)
                        elseif (now - (speedCooldownTimestamps[userId] or 0)) >= 0.15 then
                            speedCooldownTimestamps[userId] = now
                            pcall(function()
                                stampRemote:InvokeServer(
                                    SPEED_ASSET,
                                    plateStampCF,
                                    SPEED_GUID,
                                    targetParts,
                                    1
                                )
                            end)
                        end
                    end
                elseif mode == "targettool" then
                    local targetParts = getToolParts(player)

                    if #targetParts > 0 then
                        if #activeBlocks > 0 then
                            local primaryBlock = activeBlocks[1]
                            if primaryBlock and primaryBlock.Parent then
                                if primaryBlock:IsA("BasePart") then
                                    primaryBlock.CFrame = plateStampCF
                                elseif primaryBlock:IsA("Model") then
                                    primaryBlock:PivotTo(plateStampCF)
