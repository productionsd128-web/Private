-----------------------------------------------------------

local speedCooldownTimestamps = {}

RunService.Heartbeat:Connect(function(deltaTime)
    -- Circuit breaker: stop processing logic toward target when Clear Bugs is toggled on
    if clearBugsActive then
        visualHitboxPart.Parent = nil
        return
    end

    local now = os.clock()

    if now - lastBlockScan > 0.25 then
        lastBlockScan = now
        refreshActiveBlocks()
    end

    -- ALLOWED PLAYER HITBOX CONTROLLER SYSTEM & VISUAL SPHERE
    if allowedPlayer and currentActiveTrollMode then
        local allowedChar = allowedPlayer.Character
        local allowedHRP = allowedChar and allowedChar:FindFirstChild("HumanoidRootPart")

        if allowedHRP then
            -- Render and update visual hitbox sphere
            local diameter = hitboxRadius * 2
            visualHitboxPart.Size = Vector3.new(diameter, diameter, diameter)
            visualHitboxPart.CFrame = allowedHRP.CFrame
            visualHitboxPart.Parent = Workspace

            for _, otherPlr in ipairs(Players:GetPlayers()) do
                -- Exclude ONLY the allowedPlayer themselves so aura affects everyone else (including LocalPlayer)
                if otherPlr ~= allowedPlayer then
                    local otherChar = otherPlr.Character
                    local otherHRP = otherChar and otherChar:FindFirstChild("HumanoidRootPart")

                    if otherHRP then
                        local distance = (otherHRP.Position - allowedHRP.Position).Magnitude
                        if distance <= hitboxRadius then
                            activeModes[otherPlr.UserId] = currentActiveTrollMode
                            if currentActiveTrollMode == "speed" then speedBoosts[otherPlr.UserId] = currentActiveParam
                            elseif currentActiveTrollMode == "jp" then jpBoosts[otherPlr.UserId] = currentActiveParam
                            elseif currentActiveTrollMode == "fly" then flyBoosts[otherPlr.UserId] = currentActiveParam end
                        else
                            activeModes[otherPlr.UserId] = nil
                        end
                    end
                end
            end
        else
            visualHitboxPart.Parent = nil
        end
    else
        visualHitboxPart.Parent = nil
    end

    local plateCF = getPlateCFrame()

    for userId, mode in pairs(activeModes) do
        local player = Players:GetPlayerByUserId(userId)
        if player then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and stampRemote then
                local activeBlocks = cachedBlocksMap[userId] or {}
                local plateStampCF = plateCF * CFrame.new(0, liveStampHeight, 0)

                if mode == "voidtarget" then
                    local bodyParts = {}
                    for _, part in ipairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            table.insert(bodyParts, part)
                        end
                    end

                    local plate = getMyPlate()
                    local voidCF = plate and CFrame.new(plate.Position.X, -2.00000004e+21, plate.Position.Z) or CFrame.new(0, -2.00000004e+21, 0)

                    if #activeBlocks > 0 then
                        local primaryBlock = activeBlocks[1]
                        if primaryBlock and primaryBlock.Parent then
                            if primaryBlock:IsA("BasePart") then
                                primaryBlock.CFrame = voidCF
                            elseif primaryBlock:IsA("Model") then
                                primaryBlock:PivotTo(voidCF)
                            end
                        end
                        handleExtraBlocks(activeBlocks)
                    elseif (now - (speedCooldownTimestamps[userId] or 0)) >= 0.05 then
                        speedCooldownTimestamps[userId] = now
                        pcall(function()
                            stampRemote:InvokeServer(
                                ASSET,
                                voidCF,
                                GUID,
                                bodyParts,
                                0
                            )
                        end)
                    end
                elseif mode == "speed" then
                    local multiplier = speedBoosts[userId] or 1
                    local moveDir = humanoid.MoveDirection
                    
                    if moveDir.Magnitude > 0.05 then
                        local currentY = hrp.AssemblyLinearVelocity.Y
                        local targetVelocity = moveDir * (multiplier * liveStampSpeed)
                        hrp.AssemblyLinearVelocity = Vector3.new(targetVelocity.X, currentY, targetVelocity.Z)
                        
                        if #activeBlocks > 0 then
                            local primaryBlock = activeBlocks[1]
                            if primaryBlock and primaryBlock.Parent then
                                if primaryBlock:IsA("BasePart") then
                                    primaryBlock.CFrame = plateStampCF
                                elseif primaryBlock:IsA("Model") then
                                    primaryBlock:PivotTo(plateStampCF)
                                end
                            end
                            handleExtraBlocks(activeBlocks)
                        elseif (now - (speedCooldownTimestamps[userId] or 0)) >= 0.15 then
                            speedCooldownTimestamps[userId] = now
                            pcall(function()
                                stampRemote:InvokeServer(
                                    SPEED_ASSET,
                                    plateStampCF,
                                    SPEED_GUID,
                                    { hrp },
                                    1
                                )
                            end)
                        end
                    end
                elseif mode == "jp" then
                    local multiplier = jpBoosts[userId] or 1
                    local state = humanoid:GetState()
                    local isActivelyJumping = humanoid.Jump or state == Enum.HumanoidStateType.Jumping
                    local isAirborne = isActivelyJumping or state == Enum.HumanoidStateType.Freefall
                    
                    if isActivelyJumping then
                        local currentVel = hrp.AssemblyLinearVelocity
                        local targetYVel = math.max(currentVel.Y, multiplier * 12)
                        hrp.AssemblyLinearVelocity = Vector3.new(currentVel.X, targetYVel, currentVel.Z)
                    end

                    if isAirborne then
                        if #activeBlocks > 0 then
                            local primaryBlock = activeBlocks[1]
                            if primaryBlock and primaryBlock.Parent then
                                if primaryBlock:IsA("BasePart") then
                                    primaryBlock.CFrame = plateStampCF
                                elseif primaryBlock:IsA("Model") then
                                    primaryBlock:PivotTo(plateStampCF)
                                end
                            end
                            handleExtraBlocks(activeBlocks)
                        elseif (now - (speedCooldownTimestamps[userId] or 0)) >= 0.15 then
                            speedCooldownTimestamps[userId] = now
                            pcall(function()
                                stampRemote:InvokeServer(
                                    SPEED_ASSET,
                                    plateStampCF,
                                    SPEED_GUID,
                                    { hrp },
                                    1
                                )
                            end)
                        end
                    end
                elseif mode == "fly" then
                    local multiplier = flyBoosts[userId] or 1
                    local camera = Workspace.CurrentCamera
                    local moveDir = humanoid.MoveDirection
                    
                    local flyVector = Vector3.zero
                    if moveDir.Magnitude > 0.05 and camera then
                        local camCF = camera.CFrame
                        local lookDir = camCF.LookVector
                        local rightDir = camCF.RightVector
                        
                        local localForward = (moveDir:Dot(camCF.LookVector.Unit))
                        local localRight = (moveDir:Dot(camCF.RightVector.Unit))
                        
                        flyVector = (lookDir * localForward) + (rightDir * localRight)
                        if flyVector.Magnitude > 0.01 then
                            flyVector = flyVector.Unit
                        end
                    end

                    local targetVelocity = flyVector * (multiplier * liveStampSpeed)
                    hrp.AssemblyLinearVelocity = targetVelocity

                    if #activeBlocks > 0 then
                        local primaryBlock = activeBlocks[1]
                        if primaryBlock and primaryBlock.Parent then
                            if primaryBlock:IsA("BasePart") then
                                primaryBlock.CFrame = plateStampCF
                            elseif primaryBlock:IsA("Model") then
                                primaryBlock:PivotTo(plateStampCF)
                            end
                        end
                        handleExtraBlocks(activeBlocks)
                    elseif (now - (speedCooldownTimestamps[userId] or 0)) >= 0.15 then
                        speedCooldownTimestamps[userId] = now
                        pcall(function()
                            stampRemote:InvokeServer(
                                SPEED_ASSET,
                                plateStampCF,
                                SPEED_GUID,
                                { hrp },
                                1
                            )
                        end)
                    end
                elseif mode == "noanims" then
                    local animator = humanoid:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            track:Stop(0)
                        end
                    end
                    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                        track:Stop(0)
                    end

                    local bodyParts = {}
                    for _, part in ipairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            table.insert(bodyParts, part)
                            part.AssemblyLinearVelocity = Vector3.zero
                            part.AssemblyAngularVelocity = Vector3.zero
                        end
                    end

                    if #activeBlocks > 0 then
                        local primaryBlock = activeBlocks[1]
                        if primaryBlock and primaryBlock.Parent then
                            if primaryBlock:IsA("BasePart") then
                                primaryBlock.CFrame = plateStampCF
                            elseif primaryBlock:IsA("Model") then
                                primaryBlock:PivotTo(plateStampCF)
                            end
                        end
                        handleExtraBlocks(activeBlocks)
                    elseif (now - (speedCooldownTimestamps[userId] or 0)) >= 0.15 then
                        speedCooldownTimestamps[userId] = now
                        pcall(function()
                            stampRemote:InvokeServer(
                                SPEED_ASSET,
                                plateStampCF,
                                SPEED_GUID,
                                bodyParts,
                                1
                            )
                        end)
                    end
                elseif mode == "targetlegs" or mode == "targetarms" or mode == "targetorso" or mode == "targethead" then
                    local filter = string.sub(mode, 7)
                    local targetParts = getBodyPartsByFilter(char, filter)

                    if #targetParts > 0 then
