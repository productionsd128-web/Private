local function getMyPlate()
    local plates = Workspace:FindFirstChild("Plates")
    if not plates then return nil end
    for _, f in ipairs(plates:GetChildren()) do
        local o = f:FindFirstChild("Owner")
        if o and (tostring(o.Value) == LocalPlayer.Name or tostring(o.Value) == tostring(LocalPlayer.UserId)) then
            return f:FindFirstChild("Plate")
        end
    end
end

local function getPlateCFrame()
    local plate = getMyPlate()
    if plate and plate:IsA("BasePart") then
        return plate.CFrame
    end
    return CFrame.new(0, 0, 0)
end

local function getActivePartsFolder()
    local activeFolder = Workspace:FindFirstChild("ActiveParts") or Workspace:FindFirstChild("Assets")
    if activeFolder then
        return activeFolder
    end
    local plate = getMyPlate()
    return plate and plate.Parent or Workspace
end

-- Efficient Interval Block Caching
local function refreshActiveBlocks()
    local folder = getActivePartsFolder()
    if not folder then 
        cachedBlocksMap = {}
        return 
    end

    local newBlocks = {}
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("BasePart") or item:IsA("Model") then
            local isSpeedBlock = (item.Name == tostring(SPEED_ASSET)) or (item:GetAttribute("AssetId") == SPEED_ASSET)
            if isSpeedBlock then
                table.insert(newBlocks, item)
            end
        end
    end

    for userId, _ in pairs(activeModes) do
        cachedBlocksMap[userId] = newBlocks
    end
end

-- Filter helper to extract R6/R15 specific body parts
local function getBodyPartsByFilter(character, filterType)
    local parts = {}
    if not character then return parts end

    local legNames = {
        ["Left Leg"] = true, ["Right Leg"] = true,
        ["LeftFoot"] = true, ["RightFoot"] = true,
        ["LeftLowerLeg"] = true, ["RightLowerLeg"] = true,
        ["LeftUpperLeg"] = true, ["RightUpperLeg"] = true
    }

    local armNames = {
        ["Left Arm"] = true, ["Right Arm"] = true,
        ["LeftHand"] = true, ["RightHand"] = true,
        ["LeftLowerArm"] = true, ["RightLowerArm"] = true,
        ["LeftUpperArm"] = true, ["RightUpperArm"] = true
    }

    local torsoNames = {
        ["Torso"] = true, ["UpperTorso"] = true, ["LowerTorso"] = true
    }

    local headNames = {
        ["Head"] = true
    }

    local targetMap = filterType == "legs" and legNames 
        or filterType == "arms" and armNames 
        or filterType == "torso" and torsoNames 
        or filterType == "head" and headNames

    if targetMap then
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("BasePart") and targetMap[child.Name] then
                table.insert(parts, child)
            end
        end
    end

    return parts
end

-- Helper to find tools in Character (equipped) or Backpack (unequipped)
local function getToolParts(player)
    local parts = {}
    if not player then return parts end

    local function extractPartsFromTool(tool)
        for _, desc in ipairs(tool:GetDescendants()) do
            if desc:IsA("BasePart") then
                table.insert(parts, desc)
            end
        end
    end

    if player.Character then
        for _, child in ipairs(player.Character:GetChildren()) do
            if child:IsA("Tool") then
                extractPartsFromTool(child)
            end
        end
    end

    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                extractPartsFromTool(child)
            end
        end
    end

    return parts
end

