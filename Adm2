    NotifBody.TextXAlignment = Enum.TextXAlignment.Left
    NotifBody.Parent = NotifFrame

    local NotifBodyConstraint = Instance.new("UITextSizeConstraint")
    NotifBodyConstraint.MaxTextSize = 9
    NotifBodyConstraint.MinTextSize = 6
    NotifBodyConstraint.Parent = NotifBody

    local NotifScale = Instance.new("UIScale")
    NotifScale.Scale = 0
    NotifScale.Parent = NotifFrame

    TweenService:Create(NotifScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()

    task.delay(2.5, function()
        local exitTween = TweenService:Create(NotifScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0})
        exitTween:Play()
        exitTween.Completed:Connect(function()
            NotifFrame:Destroy()
        end)
    end)
end

local function applyModeToTargets(mode, customVal)
    currentActiveTrollMode = mode
    currentActiveParam = customVal

    if effectAllPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= allowedPlayer then
                activeModes[p.UserId] = mode
                if mode == "speed" then speedBoosts[p.UserId] = customVal
                elseif mode == "jp" then jpBoosts[p.UserId] = customVal
                elseif mode == "fly" then flyBoosts[p.UserId] = customVal end
            end
        end
    elseif currentTargetPlayer then
        activeModes[currentTargetPlayer.UserId] = mode
        if mode == "speed" then speedBoosts[currentTargetPlayer.UserId] = customVal
        elseif mode == "jp" then jpBoosts[currentTargetPlayer.UserId] = customVal
        elseif mode == "fly" then flyBoosts[currentTargetPlayer.UserId] = customVal end
    end
end

local function findTargetPlayer(nameQuery)
    nameQuery = string.lower(nameQuery)
    for _, p in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(p.Name), nameQuery, 1, true) or string.find(string.lower(p.DisplayName), nameQuery, 1, true) then
            return p
        end
    end
    return nil
end

local function setTargetPlayer(player)
    if not player then return end
    currentTargetPlayer = player
    TargetNameLabel.Text = "Target: " .. player.DisplayName
    TargetSubLabel.Text = "@" .. player.Name
    
    local content, isLoaded = Players:GetUserThumbnailAsync(
        player.UserId,
        Enum.ThumbnailType.HeadShot,
        Enum.ThumbnailSize.Size100x100
    )
    if isLoaded then
        TargetAvatarImg.Image = content
    end
    sendNotification("TARGET SELECT", "Target set: " .. player.Name)
end

local function setAllowedPlayer(player)
    if not player then return end
    allowedPlayer = player
    TargetNameLabel.Text = "Allowed: " .. player.DisplayName
    TargetSubLabel.Text = "@" .. player.Name .. " (Controller)"
    
    local content, isLoaded = Players:GetUserThumbnailAsync(
        player.UserId,
        Enum.ThumbnailType.HeadShot,
        Enum.ThumbnailSize.Size100x100
    )
    if isLoaded then
        TargetAvatarImg.Image = content
    end
    sendNotification("ALLOWED PLAYER", "Controller set: " .. player.Name)
end

local function clearAllowedPlayer()
    if allowedPlayer then
        local prevName = allowedPlayer.Name
        allowedPlayer = nil
        
        visualHitboxPart.Parent = nil
        
        -- Reset profile visuals
        if currentTargetPlayer then
            setTargetPlayer(currentTargetPlayer)
        else
            TargetNameLabel.Text = "Target: None"
            TargetSubLabel.Text = "Type user below or use Tool"
            TargetAvatarImg.Image = "rbxassetid://0"
        end
        
        -- Clear active modes applied by allowed player aura
        activeModes = {}
        speedBoosts = {}
        jpBoosts = {}
        flyBoosts = {}

        sendNotification("ALLOWED PLAYER", "Removed controller: " .. prevName)
    else
        sendNotification("ALLOWED PLAYER", "No allowed player currently active")
    end
end

